  "features": [
    {
      "id": "F001",
      "name": "Single Wallet Scan",
      "description": "Scan a single wallet address and generate a bot probability report",
      "priority": "P0",
      "status": "completed"
    },
    {
      "id": "F002",
      "name": "Batch Scanning",
      "description": "Scan multiple wallets from a file with concurrent processing",
      "priority": "P1",
      "status": "completed"
    },
    {
      "id": "F003",
      "name": "Real-time Monitoring",
      "description": "Continuously monitor for new trades and flag suspicious activity",
      "priority": "P2",
      "status": "completed"
    },
    {
      "id": "F004",
      "name": "Wallet Discovery",
      "description": "Discover suspicious wallets by scanning top traders on a market",
      "priority": "P2",
      "status": "planned"
    }
