  "api_endpoints": {
    "data_api": {
      "base_url": "https://data-api.polymarket.com",
      "endpoints": {
        "trades": {
          "path": "/trades",
          "method": "GET",
          "params": ["user", "limit", "offset", "market", "side"]
        },
        "positions": {
          "path": "/positions",
          "method": "GET",
          "params": ["user", "limit", "offset", "sizeThreshold"]
        },
        "holders": {
          "path": "/holders",
          "method": "GET",
          "params": ["market", "limit", "minBalance"],
          "description": "Get top holders for specified markets (max 20 per market)",
          "response": "[{token, holders: [{proxyWallet, amount, name, ...}]}]"
        }
      }
    },
    "gamma_api": {
      "base_url": "https://gamma-api.polymarket.com",
      "endpoints": {
        "markets": {
          "path": "/markets",
          "method": "GET"
        },
        "market_by_id": {
          "path": "/markets/{id}",
          "method": "GET"
        }
      }
    }
  },
  "detection_algorithms": {
    "arbitrage": {
      "weight": 0.35,
      "description": "Detects simultaneous opposing positions",
      "threshold": "price_up + price_down < 1.0"
    },
    "timing": {
      "weight": 0.25,
      "description": "Analyzes trade interval consistency",
      "threshold": "std_dev < 5 seconds"
    },
    "winrate": {
      "weight": 0.25,
      "description": "Flags statistically improbable win rates",
      "threshold": "win_rate > 0.95 AND trades > 100"
    },
    "sizing": {
      "weight": 0.15,
      "description": "Detects algorithmic position sizing",
      "threshold": "coefficient_of_variation < 0.1"
    }
  },
  "test_wallets": {
    "known_bot": {
